# ═══════════════════════════════════════════════════════════
# EVERHERE Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# ── Database ─────────────────────────────────────────────
DATABASE_URL=postgresql://everhere:password@localhost:5432/everhere?schema=public

# ── Auth / Sessions ──────────────────────────────────────
SESSION_SECRET=change-me-to-a-random-32-char-string
SESSION_MAX_AGE_HOURS=12
CSRF_SECRET=change-me-to-another-random-32-char-string

# ── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email (transactional) ────────────────────────────────
EMAIL_PROVIDER=resend          # resend | postmark | ses
EMAIL_API_KEY=your-email-api-key
EMAIL_FROM=noreply@everhere.org
EMAIL_FROM_NAME=EVERHERE

# ── CAPTCHA ──────────────────────────────────────────────
CAPTCHA_PROVIDER=hcaptcha      # hcaptcha | turnstile
CAPTCHA_SECRET=your-captcha-secret
CAPTCHA_SITE_KEY=your-captcha-site-key

# ── Object Storage (Phase 5+, file uploads) ──────────────
# OBJECT_STORAGE_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# OBJECT_STORAGE_BUCKET=everhere-files
# OBJECT_STORAGE_ACCESS_KEY=your-access-key
# OBJECT_STORAGE_SECRET_KEY=your-secret-key
# OBJECT_STORAGE_PUBLIC_URL=https://files.everhere.org

# ── Admin ────────────────────────────────────────────────
ADMIN_ALERT_EMAIL=admin@everhere.org

# ── Rate Limiting ────────────────────────────────────────
RATE_LIMIT_TRUST_PROXY=1      # 1 if behind one reverse proxy, 2 if behind two
