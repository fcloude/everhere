{
  "name": "everhere",
  "version": "0.1.0",
  "private": true,
  "description": "EVERHERE — Personal safety communication platform",
  "scripts": {
    "dev:web": "pnpm --filter @everhere/web dev",
    "dev:api": "pnpm --filter @everhere/api dev",
    "dev": "concurrently \"pnpm dev:web\" \"pnpm dev:api\"",
    "build": "pnpm --filter @everhere/shared build && pnpm --filter @everhere/web build && pnpm --filter @everhere/api build",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @everhere/api db:migrate",
    "db:generate": "pnpm --filter @everhere/api db:generate",
    "db:seed": "pnpm --filter @everhere/api db:seed"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.34.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "prettier": "^3.2.5",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  }
}
